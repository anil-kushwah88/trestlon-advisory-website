# Copy this file to .env and fill in real values before running in production.

PORT=9999

# Secret used to sign admin login tokens. Change this to a long random string.
JWT_SECRET=change-this-to-a-long-random-secret

# Default admin account created on first run (only if no admin exists yet).
ADMIN_EMAIL=admin@trustlon.com
ADMIN_PASSWORD=Trustlon@2026

# Comma separated list of origins allowed to call this API.
CORS_ORIGIN=http://localhost:5173
